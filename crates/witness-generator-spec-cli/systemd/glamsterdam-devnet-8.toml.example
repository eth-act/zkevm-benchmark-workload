network = "glamsterdam-devnet-8"

# Local Beacon API and execution JSON-RPC endpoints.
cl_url = "http://127.0.0.1:3500"
el_url = "http://127.0.0.1:8545"
# Extra HTTP headers sent to each endpoint.
# cl_headers = { "X-API-Key" = "<replace-with-api-key>" }
# el_headers = { "X-API-Key" = "<replace-with-api-key>" }

out_root = "/data/stateless-inputs"
poll_interval = "4s"
request_timeout = "30s"
batch_size = 100
# Collect every block from the chain tip onward instead of polling the head.
# continuous = true
# Blocks fetched concurrently in continuous mode.
# max_concurrency = 4

[r2]
bucket = "stateless-inputs"
prefix = "devnets"
account_id = "<replace-with-cloudflare-account-id>"
